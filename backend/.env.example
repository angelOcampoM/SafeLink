# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.

NODE_ENV=development

# 127.0.0.1 (por defecto): solo accesible desde esta computadora.
# Usa 0.0.0.0 solo para probar con el telefono en la misma red local (LAN).
HOST=127.0.0.1
PORT=3000

# Puerto del host para Postgres (Docker Compose).
DB_PORT=5433
POSTGRES_USER=safelink
# genera una aleatoria
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=safelink
DATABASE_URL=postgresql://safelink:cambia-esta-contrasena@localhost:5433/safelink
# Base separada para pruebas de integracion.
DATABASE_URL_TEST=postgresql://safelink:cambia-esta-contrasena@localhost:5433/safelink_test

# Minimo 32 caracteres (genera uno aleatorio largo; no uses un ejemplo publico).
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Origenes permitidos separados por comas. Vacio = ninguno.
CORS_ORIGINS=

# Zona horaria para turnos de guardias (turnos que cruzan medianoche).
TZ_SHIFTS=America/Mexico_City

# Reglas de dominio (equivalen a lib/dominio/configuracion.dart y, para
# ADMIN_NOTE_MAX_LENGTH, a lib/dominio/regla_alerta.dart)
GEOFENCE_METERS=50
ACCEPT_TIMEOUT_SECONDS=300
CONFIRM_TIMEOUT_SECONDS=900
FALSE_ALARM_LIMIT=3
BLOCK_DAYS=7
LOCATION_UPDATE_SECONDS=5
WAIT_METERS_PER_MINUTE=100
GUARD_METERS_PER_MINUTE=250
COVERAGE_RADIUS_MIN_METERS=500
COVERAGE_RADIUS_MAX_METERS=10000
ADMIN_NOTE_MAX_LENGTH=300
