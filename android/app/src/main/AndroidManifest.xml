<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- La app habla con la API por red en cualquier variante. Estaba declarado solo en los
         manifests debug y profile, así que un APK de release no podía conectarse
         (hallazgo de docs/CONEXION_DISPOSITIVO.md §5). No permite tráfico en claro: eso
         sigue siendo solo de debug (usesCleartextTraffic). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- U-06 · Foto automática de la alerta. `required=false`: un teléfono sin cámara debe
         poder instalar la app; la alerta viaja marcada como evidencia incompleta. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- U-06 · U-07 · G-06 · Ubicación de la alerta y seguimiento mientras dura. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- G-02 · Aviso de alerta nueva al guardia (D44). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- U-05 · Vibración de confirmación al disparar sin mirar la pantalla. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- U-05 · Abrir la alerta con el teléfono bloqueado y la pantalla apagada. Desde
         Android 10 una app en segundo plano no puede abrir pantallas por su cuenta: el
         camino válido es una notificación de pantalla completa, como las llamadas. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:allowBackup="false"
        android:label="safelink"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- U-05 · Servicio que escucha el doble clic de volumen, también con la pantalla
             bloqueada. BIND_ACCESSIBILITY_SERVICE lo exige Android; la persona lo activa a
             mano en Ajustes → Accesibilidad (la app no puede encenderlo). -->
        <service
            android:name=".VolumenAccessibilityService"
            android:exported="false"
            android:label="@string/accesibilidad_volumen_nombre"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad_volumen"/>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- G-06 (CR-F04): url_launcher necesita ver qué app abre enlaces https (Google Maps
             o el navegador) para "Abrir en Google Maps". Android 11+ lo exige. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
